Bootstrap: docker
From: python:3.12-slim-bookworm

%setup
    mkdir -p ${SINGULARITY_ROOTFS}/opt/program
    cp -r src/ pyproject.toml uv.lock README.md ${SINGULARITY_ROOTFS}/opt/program/

%post
    # install git, curl, certificates, and a C compiler needed to build the
    # plmc binary
    apt-get update && apt-get install -y git curl ca-certificates build-essential && rm -rf /var/lib/apt/lists/*

    # build plmc with OpenMP support, so the wrapper's "cpu" hyperparameter
    # can parallelize fitting across cores
    git clone --depth 1 https://github.com/debbiemarkslab/plmc.git /opt/plmc
    cd /opt/plmc && make all-openmp32
    ln -s /opt/plmc/bin/plmc /usr/local/bin/plmc

    # install uv (defaults to /root/.local/bin)
    curl -LsSf https://astral.sh/uv/install.sh | sh

    # move binaries to a globally accessible system path
    mv /root/.local/bin/uv /root/.local/bin/uvx /usr/local/bin/

    # sync dependencies
    cd /opt/program
    uv sync --no-cache

%environment
    export PATH="/opt/program/.venv/bin:$PATH"

%runscript
    cd /opt/program
    exec uv run --no-sync evmutation "$@"
